; Engine configuration file.
; Godot 4.4.1 — Haigen's World parallel homestead prototype.
; Isolated from the HTML game. Do not publish via Pages as the live game.

config_version=5

[application]

config/name="Haigen Homestead Prototype"
config/description="Parallel Godot 4.4 V0 slice: woodland homestead movement prototype. Not the live HTML game."
config/version="0.1.0-proto"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://assets/tiles/tree.png"

[autoload]

GameConfig="*res://scripts/autoload/game_config.gd"
InputRouter="*res://scripts/autoload/input_router.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

